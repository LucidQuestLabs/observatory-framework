{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatory-framework.local/schemas/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": [
    "observation_id",
    "created_at",
    "created_by",
    "target_id",
    "category",
    "observation_text",
    "source_ids",
    "confidence",
    "confidence_reason",
    "interpretation_level",
    "review_status",
    "publication_status"
  ],
  "properties": {
    "observation_id": { "type": "string", "pattern": "^obs_[0-9]{8}_[a-z0-9-]+_[0-9]{3,}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" },
    "target_id": { "type": "string" },
    "entity_ids": { "type": "array", "items": { "type": "string" } },
    "facility_ids": { "type": "array", "items": { "type": "string" } },
    "jurisdiction": { "type": "string" },
    "category": { "type": "string", "enum": ["water", "energy", "land", "permitting", "ownership", "community", "environment", "finance", "legal", "timeline", "facility", "contradiction", "other"] },
    "observation_text": { "type": "string" },
    "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "source_quotes": { "type": "array", "items": { "type": "string" } },
    "source_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string" },
          "page": { "type": "string" },
          "section": { "type": "string" },
          "line": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "date_observed_in_source": { "type": ["string", "null"], "format": "date" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence_reason": { "type": "string" },
    "interpretation_level": { "type": "string", "enum": ["direct", "inferred", "speculative"] },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["water_stress", "grid_load", "diesel_backup", "air_quality", "noise", "tax_incentive", "public_notice_gap", "ownership_opacity", "rapid_permitting", "community_concern", "environmental_review_gap", "source_conflict", "needs_public_records_request", "legal_review_needed", "high_public_interest"]
      }
    },
    "review_status": { "type": "string", "enum": ["pending", "approved", "rejected", "needs_clarification", "superseded"] },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string" },
    "review_notes": { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "array", "items": { "type": "string" } },
    "publication_status": { "type": "string", "enum": ["internal", "public_ready", "redacted", "embargoed"] }
  },
  "additionalProperties": false
}

